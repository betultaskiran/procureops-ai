# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy this file to .env and fill in your values.
# The .env file is listed in .gitignore and will NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=ProcureOps AI
ENVIRONMENT=development    # development | staging | production
DEBUG=true                 # MUST be false in production

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# In production, use high-entropy credentials (at least 8 chars, never default placeholders)
POSTGRES_USER=procureops
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=procureops_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Qdrant Vector Database ──────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Google Gemini (LLM & Embeddings) ─────────────────────────────────────────
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ─── Security & Authentication (JWT & Cookies) ───────────────────────────────
# In production, generate a secure random 64-character secret using:
#   openssl rand -hex 32
JWT_SECRET_KEY=dev-secret-change-in-production-only-procureops-jwt-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS & Network Origins ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no wildcards in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Observability & Monitoring ──────────────────────────────────────────────
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console         # console | json
# SENTRY_DSN=https://your_sentry_key@o0.ingest.sentry.io/0

# ─── Frontend Configuration ──────────────────────────────────────────────────
# NEXT_PUBLIC_ prefix makes this available in client-side browser code
NEXT_PUBLIC_API_URL=http://localhost:8000
