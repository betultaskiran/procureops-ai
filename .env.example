# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy this file to .env and fill in your values.
# The .env file is listed in .gitignore and will NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=ProcureOps AI
DEBUG=true

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# These values are used by both the postgres container and the backend.
POSTGRES_USER=procureops
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=procureops_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Qdrant ──────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── LLM Provider (not used until Phase 3) ───────────────────────────────────
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# ─── Frontend ────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ prefix makes this available in browser-side code.
NEXT_PUBLIC_API_URL=http://localhost:8000
