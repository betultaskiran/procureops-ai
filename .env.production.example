# ─────────────────────────────────────────────────────────────────────────────
# .env.production.example — ProcureOps AI Production Environment Template
#
# INSTRUCTIONS FOR OPERATORS / DEPLOYERS:
# 1. Copy this file to '.env.production' on your production host:
#      cp .env.production.example .env.production
# 2. Populate all required secrets and credentials below.
# 3. Restrict file permissions immediately:
#      chmod 600 .env.production
# 4. NEVER commit '.env.production' or any file containing real credentials to Git.
#    (.gitignore is pre-configured to strictly ignore all .env.* files except templates).
# 5. When running production Docker Compose:
#      docker compose -f docker-compose.prod.yml --env-file .env.production config
#      docker compose -f docker-compose.prod.yml --env-file .env.production run --rm backend-migration
#      docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# ─── 1. Application & Core Invariants ─────────────────────────────────────────
APP_NAME="ProcureOps AI"
APP_VERSION=0.1.0

# MUST be 'production' in production. Enables strict validation and security headers.
ENVIRONMENT=production

# MUST be 'False' in production. Pydantic fail-closed validation will refuse to start if True.
DEBUG=False

# Worker processes for Uvicorn (recommendation: 2-4 depending on CPU cores)
WEB_CONCURRENCY=2


# ─── 2. Cryptographic Secrets (MANDATORY & HIGH-ENTROPY) ─────────────────────
# Generate unique, 64-character hex secrets on your production host using:
#   openssl rand -hex 32
#
# WARNING: Pydantic validation enforces that JWT_SECRET_KEY is at least 32 characters
# and rejects the development placeholder default.
JWT_SECRET_KEY=<GENERATE_WITH_OPENSSL_RAND_HEX_32_MIN_32_CHARS>
SECRET_KEY=<GENERATE_WITH_OPENSSL_RAND_HEX_32_MIN_32_CHARS>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ─── 3. Domain, URLs & Network Origins ────────────────────────────────────────
# Base URL for public frontend access (used to construct supplier portal links and emails)
APP_BASE_URL=https://procureops.yourdomain.com

# Public API endpoint used by client-side frontend code
NEXT_PUBLIC_API_URL=https://procureops.yourdomain.com/api

# Allowed CORS origins. Formatted as a valid JSON array of allowed origins.
# SECURITY: Wildcard '*' is strictly forbidden when authentication credentials/cookies are enabled.
CORS_ORIGINS=["https://procureops.yourdomain.com"]

# ─── 4. Trusted Reverse Proxies (CRITICAL FOR RATE LIMITING & IP AUDIT) ──────
# Specifies which upstream proxy IPs or CIDR blocks are permitted to supply client IP
# addresses via X-Forwarded-For.
#
# SECURITY ARCHITECTURE NOTE:
# - If TRUSTED_PROXIES is empty ([]), all X-Forwarded-For headers are ignored and the direct
#   peer connection IP is used. This prevents IP spoofing by untrusted clients.
# - DO NOT blindly copy subnet ranges (e.g. 172.18.0.0/16). Determine your actual topology:
#
# TOPOLOGY A: Reverse proxy (Nginx, Caddy, Traefik) installed on the Docker host OS
#   When backend binds to '127.0.0.1:8000', Docker bridges the connection.
#   The peer IP seen inside the container is typically the Docker bridge gateway IP:
#     TRUSTED_PROXIES=["127.0.0.1", "172.17.0.1"]  (inspect with: docker network inspect bridge)
#
# TOPOLOGY B: Reverse proxy container in the same Docker network (e.g., Nginx container)
#   The peer IP is the internal Docker IP of the proxy container or Docker subnet:
#     TRUSTED_PROXIES=["172.20.0.0/16"]  (adjust to match your docker-compose network subnet)
#
# TOPOLOGY C: Cloud Load Balancer (AWS ALB, GCP Cloud LB)
#   Specify your private VPC subnet CIDR block:
#     TRUSTED_PROXIES=["10.0.0.0/16"]
#
# TOPOLOGY D: Cloudflare Tunnel / Cloudflare Proxy
#   Specify Cloudflare's published IP ranges (or your local cloudflared tunnel client IP).
#
# Default safe starting configuration for host-level proxy:
TRUSTED_PROXIES=["127.0.0.1"]


# ─── 5. Database (PostgreSQL 16) ─────────────────────────────────────────────
# In production, services communicate over the internal Docker network using service name 'postgres'.
# The database port (5432) is NOT published to the host for maximum security.
POSTGRES_USER=procureops_prod
POSTGRES_PASSWORD=<STRONG_RANDOM_PASSWORD_MIN_16_CHARS_NEVER_DEFAULT>
POSTGRES_DB=procureops_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432


# ─── 6. Vector Store (Qdrant) ────────────────────────────────────────────────
# Vector search engine for Hybrid Policy RAG.
# Communicates internally via Docker service name 'qdrant'.
# Host ports (6333/6334) are NOT published in production.
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# QDRANT_API_KEY=<OPTIONAL_QDRANT_API_KEY_IF_CLUSTER_AUTHENTICATION_ENABLED>


# ─── 7. Cache & Rate Limiting (Redis 7) ──────────────────────────────────────
# Backing store for SlowAPI rate limiting and session tokens.
# Communicates internally via Docker service name 'redis'.
# Host port (6379) is NOT published in production.
REDIS_HOST=redis
REDIS_PORT=6379


# ─── 8. Google Gemini (LLM & Embeddings) ─────────────────────────────────────
# Production Google AI Studio API key with appropriate quota/billing.
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<YOUR_GOOGLE_AI_STUDIO_PRODUCTION_API_KEY>
GEMINI_MODEL=gemini-3.5-flash-lite


# ─── 9. File Storage ─────────────────────────────────────────────────────────
# Upload storage path inside container (mounted to 'backend_uploads' persistent volume)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50


# ─── 10. Email & SMTP Provider (PRODUCTION TRANSACTIONAL EMAIL) ──────────────
# Pydantic fail-closed validation will REJECT 'localhost' or '127.0.0.1' in production.
# Configure your verified production transactional email provider:
#   - SendGrid: smtp.sendgrid.net (port 587, user 'apikey', password <api_key>)
#   - AWS SES: email-smtp.<region>.amazonaws.com (port 587, STARTTLS)
#   - Mailgun: smtp.mailgun.org (port 587, STARTTLS)
#   - Postmark: smtp.postmarkapp.com (port 587, STARTTLS)
#   - Google Workspace / M365: corporate SMTP relay
#
# CRITICAL DELIVERABILITY REQUIREMENTS:
# 1. Your domain's DNS must have SPF records configured: v=spf1 include:... ~all
# 2. DKIM CNAME/TXT records must be verified with your provider.
# 3. DMARC policy must be published: v=DMARC1; p=reject (or quarantine).
# 4. Host firewall must allow outbound egress to port 587 or 465.
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=<YOUR_SMTP_PROVIDER_USERNAME_OR_API_KEY_NAME>
SMTP_PASSWORD=<YOUR_SMTP_PROVIDER_PASSWORD_OR_API_KEY_SECRET>
SMTP_FROM_EMAIL=procurement@yourdomain.com
SMTP_FROM_NAME="ProcureOps AI Procurement"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BACKOFF_SECONDS=30
ENABLE_OUTBOX_WORKER=true


# ─── 11. Observability & Logging ─────────────────────────────────────────────
# JSON log format is recommended in production for ingestion by Vector/Fluentbit/CloudWatch/Datadog.
LOG_LEVEL=INFO
LOG_FORMAT=json

# Sentry DSN for production crash reporting and APM (optional)
# SENTRY_DSN=https://<public_key>@o<org_id>.ingest.sentry.io/<project_id>
